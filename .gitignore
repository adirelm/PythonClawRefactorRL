instructions/
instructions/assignment-4/

# Moodle cover sheet — contains PII (ID card + personal name + self-grade); upload to moodle ONLY, never commit
adrl-001-ex*.pdf

# Runtime data (regenerated; not version-controlled)
data/raw/
data/processed/
results/checkpoints/
results/ablation/

# Checkpoint policy (intentional split):
#  • results/training/seed_*/checkpoint.pt (canonical 5-seed headline run) ARE
#    committed so a grader can load/replay the trained policy without retraining
#    (reproducibility of the §3/§5.1 headline result).
#  • The extended P4-E3 run's checkpoints are ~11 MB each and regenerable via the
#    command in docs/EXPERIMENTS.md P4-E3, so they are git-ignored; only their
#    lightweight reward/metric records (rewards.csv, metrics.json, aggregate.json) ARE committed.
results/training_converged/**/checkpoint.pt

# Obsidian vault internals — keep the vault dir tracked but exclude editor state
results/vault/.obsidian/

# Notebook scratch
.ipynb_checkpoints/

# OS
Thumbs.db

# Stray PDFs (allow only those under docs/assets/)
*.pdf
!docs/assets/*.pdf

# Vendored upstream source under analysis (fetched at pinned SHA via scripts/fetch_pythonclaw.py)
vendor/
